{
  "name": "fichario-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "App web de Fichario: TypeScript sin framework, compilada con esbuild.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e.mjs",
    "serve": "node serve.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
